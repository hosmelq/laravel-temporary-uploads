{
    "name": "hosmelq/laravel-temporary-uploads",
    "description": "Temporary upload URLs, file retrieval, and cleanup for Laravel using S3-compatible storage.",
    "license": "MIT",
    "keywords": [
        "laravel",
        "s3",
        "uploads"
    ],
    "authors": [
        {
            "name": "Hosmel Quintana",
            "email": "hosmelq@gmail.com"
        }
    ],
    "homepage": "https://github.com/hosmelq/laravel-temporary-uploads",
    "support": {
        "docs": "https://github.com/hosmelq/laravel-temporary-uploads#readme"
    },
    "require": {
        "php": "^8.4",
        "aws/aws-sdk-php": "^3.406.0",
        "illuminate/config": "^13.42.0",
        "illuminate/console": "^13.42.0",
        "illuminate/contracts": "^13.42.0",
        "illuminate/filesystem": "^13.42.0",
        "illuminate/http": "^13.42.0",
        "illuminate/support": "^13.42.0",
        "league/flysystem": "^3.36.0",
        "league/flysystem-aws-s3-v3": "^3.35.3",
        "nesbot/carbon": "^3.15.1",
        "spatie/laravel-package-tools": "^1.93.3",
        "thecodingmachine/safe": "^3.4.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.57.0",
        "hosmelq/php-coding-standard": "^1.5.0",
        "larastan/larastan": "^3.15.0",
        "orchestra/testbench": "^11.3.0",
        "pestphp/pest": "^5.3.6",
        "pestphp/pest-plugin-agent": "^5.0.0",
        "pestphp/pest-plugin-rector": "^5.0.6",
        "shipmonk/composer-dependency-analyser": "^1.8.4"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "HosmelQ\\TemporaryUploads\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HosmelQ\\TemporaryUploads\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "HosmelQ\\TemporaryUploads\\TemporaryUploadsServiceProvider"
            ]
        }
    },
    "scripts": {
        "ecs": "ecs check --fix",
        "phpstan": "phpstan analyse --memory-limit=4G",
        "rector": "rector",
        "test": "pest",
        "test-coverage": "pest --coverage"
    },
    "scripts-descriptions": {
        "ecs": "Runs ECS.",
        "phpstan": "Runs PHPStan analyse.",
        "rector": "Runs Rector.",
        "test": "Runs the Pest test suite.",
        "test-coverage": "Runs the Pest test suite with code coverage."
    },
    "$schema": "https://getcomposer.org/schema.json"
}
